# Copy to .env and adjust. NEVER commit the real .env file.

# PostgreSQL connection. Local development default:
DATABASE_URL="postgresql://erp_app:CHANGE_ME@127.0.0.1:5432/erp_kayan?schema=public"

# API server
PORT=3000
NODE_ENV=development

# JWT signing secrets — generate with:  openssl rand -base64 48
# These MUST be different in every environment and must never be shared.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Comma-separated list of allowed browser origins (Flutter web dev server).
CORS_ORIGINS="http://localhost:8080,http://localhost:3000"
# Outside production any http://localhost:<port> or http://127.0.0.1:<port> is
# accepted as well, so the Flutter web dev server works whatever port it picks.

# Where the program may be opened from, and how it learns the truth about the
# address it was reached on. See docs/NETWORK_ACCESS.md for the whole picture.
#
# The API already answers on every interface (HOST defaults to 0.0.0.0), so a
# phone or a second desk on the same network can open http://<this machine>:3000
# once the Windows firewall lets the port through. Nothing is needed here for
# that, and nothing should be added: an address on the network is not a secret.
#
# A TLS proxy (Caddy, nginx) in front of this server, on the other hand, hides
# the caller: every request then arrives from the proxy. Say so, and the rate
# limiter counts people instead of one proxy, and HTTPS is recognised.
#   loopback - the proxy runs on this machine (the usual case)
#   true     - only the proxy can reach this port at all
#   2        - two proxies in front, e.g. a load balancer then nginx
# TRUST_PROXY=loopback
#
# Redirect plain HTTP to HTTPS. Only switch this on when something in front is
# definitely serving HTTPS, or nobody reaches the program. /api/v1/health is
# never redirected, so a proxy can still ask whether the server is alive.
# KAYAN_REQUIRE_HTTPS=false
#
# HSTS is sent over TLS only, for a year by default.
# KAYAN_HSTS=true
# KAYAN_HSTS_MAX_AGE=31536000
