# ---------------------------------------------------------------------------
# KAYAN ERP - the settings a packaged desktop copy runs with.
#
# The desktop program does NOT read this file. It creates its own copy on the
# machine it is installed on, at:
#
#     %APPDATA%\KAYAN-ERP\kayan.env          (Windows)
#     ~/.local/share/KAYAN-ERP/kayan.env     (Linux)
#     ~/Library/Application Support/KAYAN-ERP/kayan.env   (macOS)
#
# with fresh random signing secrets, and reads that copy at every start. This
# file is only the reference: it says which settings exist and what they mean.
# It is safe to commit because it carries no real secret.
# ---------------------------------------------------------------------------

# The API binds to the loopback address for a desktop installation. The shell
# passes this in; it is written here so the setting is documented.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# The account the program uses to read and write the company's data.
DATABASE_URL="postgresql://erp_app:postgres@127.0.0.1:5432/erp_kayan?schema=public"

# An administrator account, used once per installation to create the database
# and the account above if they are missing. Leave it empty to skip that step
# on a machine where the database is already prepared.
ADMIN_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# Signing keys for the tokens users sign in with. The desktop program writes
# long random values here on first run. Never copy a development value.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Reaching this installation from elsewhere on the company's network, and from
# outside it. A desktop copy binds to 127.0.0.1 (HOST above) and needs none of
# this; a server copy answers on every interface, so the LAN can open it, and
# these three lines are what a TLS proxy in front of it needs. Full procedure:
# docs/NETWORK_ACCESS.md, and scripts\lan-access.ps1 says what is and is not
# open on the machine it runs on.
#
# Believes X-Forwarded-For / X-Forwarded-Proto from a proxy: loopback when the
# proxy is installed on this machine, true when only the proxy can reach this
# port, or the number of proxies in front. Without it, every user looks like
# one address to the sign-in rate limiter.
TRUST_PROXY=loopback
# 308-redirects plain HTTP to the same HTTPS address (never /api/v1/health).
# Only turn this on once the proxy really serves HTTPS.
KAYAN_REQUIRE_HTTPS=false
# Sent over TLS responses only.
KAYAN_HSTS=true
KAYAN_HSTS_MAX_AGE=31536000
